# ===============================================
# Configuración del Entorno SolarHub EMS
# ===============================================

# Modo Depuración (true/false)
SOLAR_DEBUG=false

# Nombre de la instalación
SOLAR_APP_NAME="SolarHub Industrial Gateway"

# Almacenamiento y Base de Datos SQLite Asíncrona
SOLAR_STORAGE__DATABASE_URL=sqlite+aiosqlite:///./data/solar_metrics.db
SOLAR_STORAGE__BUFFER_FLUSH_SECONDS=60
SOLAR_STORAGE__RETENTION_DAYS=30

# Puerto del Gateway Edge
PORT=8080
