venv/
ENV/
env/
.venv

# Database and logs
*.db
*.sqlite3
*.log
data/
/data/*
!data/.gitkeep

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment and secrets
.env
!.env.example

# IDEs
.idea/
.vscode/
*.swp
*.swo
